// Change Log:
//
// 08/19/2026 - local fix (not upstream)
// - Fixed a manifold defect in the divider ("spacer") cubes: they union() into
//   the hollowed interior cavity with X/Z faces exactly coincident with the
//   cavity walls, which CGAL resolves as degenerate zero-thickness geometry
//   rather than a clean union. Extended each divider by this file's own `e`
//   epsilon on X/Z to force genuine overlap (invisible at print scale). Found
//   and verified via bisection + openscad-mesh-check.sh: went from 24 boundary
//   edges / 16 degenerate facets / 18 shells down to 8 / 4 / 5 in the default
//   config. See the fix itself (search "Fix (Aug 2026)") for detail.
// - REMAINING KNOWN ISSUE: the residual 8 boundary edges / 4 degenerate facets
//   are confirmed unconditional (present with spacers/finger-cutout/lid-locks
//   all disabled too — baked into the base box shell / cavity / cutout
//   structure, not any optional feature). Pinned down the exact 3D coordinates
//   via a one-off diagnostic (both clusters sit exactly on the box's own outer
//   Y=0 and Y=deck_height+walls planes) and tried the most likely fix based on
//   that location (the lid_finger_cut_radius cylinder's un-padded Z=0 start,
//   same bug class as the divider fix) — applied it as a genuine defensive
//   improvement regardless, but VERIFIED it does NOT move or reduce this
//   specific defect (identical coordinates before/after the change). So the
//   true cause is still unidentified after two rounds of investigation; would
//   need actual visual 3D inspection (not just code reading or coordinate
//   correlation) to pin down further, which wasn't attempted. Practically
//   minor: 8 edges out of 44k+ triangles ("Simple: yes" per OpenSCAD's own
//   check) is the kind of defect most slicers auto-repair silently; unlikely
//   to be visible in an actual print, unlike the original 24/16.
//
// 05/03/2020 - v1.5
// - Fixed fingers cutouts feature to cut through all of spacers
//
// 03/21/2019 - v1.4
// - Added lid locks feature
// - Added fingers cutouts feature
//
// 07/01/2017 - v1.3
// - Fixed gap calculation, now gap decreasing both lid and box top thickness proportionally
//
// 06/29/2017 - v1.2
// - Fixed spacers location calculation
//
// 06/28/2017 - v1.1
// - Now you can divide your box with spacers
// - Improve Customizer GUI 
//
// 06/26/2017 - v1.0
// - Initial Release
//

/* [General] */

// ============================================================
// PRINT PROFILE (see PRINTER.md for full slicer profile values)
// ------------------------------------------------------------
// Material:    PLA Basic — tabletop card box, no load/heat/UV case; PLA's
//               tighter dimensional accuracy also helps the lid friction-fit
//               and finger-cutout/lid-lock features close cleanly.
// Nozzle:      0.4mm — no fine text/detail, wall_thickness default is 1.8mm
//               (a few line widths), no reason to go finer.
// Quality:     0.20mm Standard.
// Infill:      15% (printer default) — thin-walled decorative/light-duty box,
//               no load-bearing case.
// Orientation: print box and lid each as modeled (floor/lid-top down, walls
//               up) — that's the only orientation that avoids supports on the
//               walls, dividers, and lid-lock features.
// Overrides:   none. Print a quick test of the lid fit before committing to a
//               full box+lid+divider set — PLA's low layer-adhesion shrink and
//               this file's thin 1.8mm walls mean the lid tolerance is worth
//               confirming once rather than assuming. Also: run
//               openscad-mesh-check.sh on the exported STL before printing —
//               see the 08/19/2026 changelog entry above for a known small
//               residual manifold defect (fixed most of it; ~8 boundary edges
//               remain, likely inconsequential but not yet fully resolved).
// ============================================================

// Choose what part you want to build
part = "both"; // [both:Both, box:Box, lid:Lid]
// Deck width. Don't forget to leave some extra space.
deck_width = 65; // [5:.1:500]
// Deck length. Don't forget to leave some extra space.
deck_length = 95; // [5:.1:500]
// Coma separated deck thicknesses
deck_thicknesses = [25,5,25,5];
// Spacer between decks
deck_spacer = .9; // [.1:.1:5]
// Box lid height
lid_height = 20; // [5:.1:100]
// Cutout radius for finger in the lid. Use 0 for no cutout.
lid_finger_cut_radius = 15; // [0:1:50]
// Lid locks length. Use 0 for no locks.
lid_locks_length = 5; // [0:.1:20]
// Wall thickness. Choose carefully so your printer can make at least 2 outlines at the narrowest part (top of the box and lid). For 0.4 nozzle this should be at least 1.6.
wall_thickness = 1.8; // [0.2:.1:10]
// Space between lid and box top. The smaller this parameter will be, the tighter box will close.
gap = .3; // [.0:0.02:1.0]
// Depth of text and logo engrave. Depth < 0 will make relief.
engrave_depth = -.9; // [-10:.1:10]
// Whether to engrave both sides of the box
mirror = true;

/* [Text line 1] */

// First text line to engrave
text_1 = "SPELLFIRE";
// First text line font size
text_1_size = 8; //[.1:.1:50]
